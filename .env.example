# Supabase (Project Settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (API Keys)
RESEND_API_KEY=
# Debe ser una dirección de un dominio verificado en Resend.
# Mientras no verifiques un dominio propio podés dejar onboarding@resend.dev,
# pero Resend solo te va a dejar enviar a tu propio mail de cuenta en ese caso.
RESEND_FROM_EMAIL="Terroir Camp <promos@tu-dominio.com>"

# Opcional: mail donde te avisan errores/consultas (no usado por el código todavía)
CONTACT_EMAIL=
